# Environment: "development" (default) or "production". In production the server
# REFUSES to start with a default/weak JWT_SECRET or ADMIN_PASSWORD, or a
# wildcard/empty CLIENT_ORIGIN.
ANTENNE_ENV=development

# HTTP
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Comma/space-separated CIDRs or IPs of trusted reverse proxies whose
# X-Forwarded-For / CF-Connecting-IP headers are honoured. Empty = loopback +
# RFC1918 private ranges. Set this to your proxy's address if it is public.
TRUSTED_PROXIES=

# Postgres (repo-local dev cluster from `mise run db-up`)
DATABASE_URL=postgres://antenne:antenne@127.0.0.1:5433/antenne?sslmode=disable

# Auth
# In production set a strong random value (>=16 chars), e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
# Bootstrap admin created on first run if none exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Storage & stream (runtime data, kept out of git)
STORAGE_DIR=./data/tracks
STREAM_DIR=./data/stream
CLIPS_DIR=./data/clips

# Audio engine
FFMPEG_BIN=ffmpeg
CROSSFADE_MS=2000
HLS_SEGMENT_SEC=3
HLS_LIST_SIZE=6

# Continuous MP3 broadcast (ICY/Icecast-style) for external players (VLC, TuneIn…)
# Served at /stream.mp3, with /stream.pls and /stream.m3u playlist files.
MP3_STREAM_ENABLED=true
MP3_BITRATE_K=128
ICY_METAINT=16000
STATION_NAME=Antenne
STATION_GENRE=Various
STATION_URL=
STATION_DESCRIPTION=
# Set to true to advertise the stream for public directory listing (icy-pub).
STATION_PUBLIC=false
